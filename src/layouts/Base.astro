---
import '../styles/global.css';
import display from '../fonts/archivo-display.woff2?url';
import archivo from '../fonts/archivo.woff2?url';
import serif from '../fonts/serif.woff2?url';
import mono from '../fonts/mono.woff2?url';
import { meta } from '../lib/load';

interface Props {
  title: string;
  description: string;
  url: string;
  image: string;
  imageW?: number;
  imageH?: number;
  imageAlt: string;
  preloadData?: string;
  preloadUi?: boolean;
}
const { title, description, url, image, imageW = 1200, imageH = 627, imageAlt, preloadData, preloadUi = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0B1719" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={meta.author.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${meta.headline}: AI at UNGA81`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(imageW)} />
    <meta property="og:image:height" content={String(imageH)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
    {preloadUi && <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    {preloadData && <link rel="preload" href={preloadData} as="fetch" type="application/json" crossorigin />}
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      if (/[?&]v=index(&|$)/.test(location.search)) document.documentElement.dataset.view = 'index';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
