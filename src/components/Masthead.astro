---
import { meta, S, base } from '../lib/load';
import { copy } from '../lib/copy';
---

<header class="masthead wrap" id="top">
  <p class="credit micro">
    <a class="nerd-lab" href={copy.creditUrl}>
      <svg viewBox="0 0 700 176" aria-hidden="true" focusable="false">
        <g transform="translate(38,38)" fill="none" stroke="currentColor" stroke-width="24" stroke-linecap="butt" stroke-linejoin="miter">
          <path d="M12 100 L12 0 L64 100 L64 0"/>
          <g transform="translate(90,0)" stroke="none" fill="currentColor">
            <rect x="6" y="0" width="56" height="24"/>
            <rect x="20" y="38" width="56" height="24"/>
            <rect x="6" y="76" width="56" height="24"/>
          </g>
          <path transform="translate(172,0)" d="M12 100 L12 0 M12 12 H40 Q64 12 64 33 Q64 54 40 54 H12 M40 54 L66 100"/>
          <path transform="translate(264,0)" d="M12 100 L12 0 M12 12 H38 Q66 12 66 50 Q66 88 38 88 H12"/>
          <path transform="translate(384,0)" d="M12 0 L12 88 L56 88"/>
          <path transform="translate(458,0)" d="M6 100 L38 0 L70 100 M22 64 H54"/>
          <path transform="translate(548,0)" d="M12 100 L12 0 M12 12 H36 Q58 12 58 30 Q58 48 36 48 H12 M12 48 H38 Q64 48 64 68 Q64 88 38 88 H12"/>
        </g>
      </svg>
      <span>{copy.credit}</span>
    </a>
  </p>
  <div class="tagrow">
    <span class="tag">{copy.tag}</span>
    <span class="kicker micro">{copy.kicker(meta)}</span>
  </div>
  <h1 class="headline">{meta.headline}</h1>
  <p class="deck">{copy.deck1(S)} <span class="mute">{copy.deck2(S)}</span></p>
</header>
<div class="bar" id="bar" aria-hidden="true">
  <div class="wrap">
    <a class="bar-title" href={`${base}/`} tabindex="-1">{meta.headline}</a>
    <span class="micro">{copy.kicker(meta).split('  ')[1]}</span>
  </div>
</div>
<script>
  const bar = document.getElementById('bar')!;
  const top = document.getElementById('top')!;
  new IntersectionObserver(([e]) => bar.classList.toggle('on', !e.isIntersecting), { rootMargin: '-40px 0px 0px 0px' }).observe(top);
</script>
